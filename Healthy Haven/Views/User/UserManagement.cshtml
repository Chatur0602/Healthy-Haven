@{
    ViewData["Title"] = "User Management";
}

@model IEnumerable<UserEntity>

<div>
    <div class="row pt-4">
        <div class="col-9">
            <h2 class="text-success">List Of Users</h2>
        </div>
        <div class="col-12 text-lg-end">
            <a asp-controller="User" asp-action="AddUser" class="btn btn-success">Add User</a>
        </div>
    </div>
    <br />
    @if (Model != null && Model.Count() > 0)
    {
        <table class="table table-bordered table table-striped" width="100%">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>Age</th>
                    <th>Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td width="15%">@item.FirstName</td>
                        <td width="15%">@item.LastName</td>
                        <td width="15%">@item.Email</td>
                        <td width="5%">@item.Gender</td>
                        <td width="5%">@item.Age</td>
                        <td width="30%">@item.Address</td>
                        <td width="15%">
                            <div class="w-100 btn-group" role="group">
                                <a asp-controller="User" asp-action="EditUser" asp-route-Id="@item.UserId"
                                   class="btn btn-primary mx-1">Edit</a>
                                <a asp-controller="User" asp-action="DeleteUser" asp-route-Id="@item.UserId"
                                   class="btn btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>