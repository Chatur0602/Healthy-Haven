@model ConsultationsEntity

<form method="post" asp-action="InstructorEdit">
    <input asp-for="id" hidden />
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-black">Modify Consultations Details</h2>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="description">Description</label>
                <input asp-for="description" class="form-control" value="@Model.description" />
                <span asp-validation-for="description" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="student_id">Student</label>
                <input asp-for="student_id" class="form-control" value="@Model.student_id" />
                <select asp-for="student_id" class="form-control" asp-items="@ViewBag.Members"></select>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="date">Date</label>
                <input asp-for="date" class="form-control" value="@Model.date.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="date" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-primary" value="Save details" />
            <a asp-action="ConsultationsInstructor" class="btn btn-primary mx-1">Back To List</a>
        </div>
    </div>
</form>
