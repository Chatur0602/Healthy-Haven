@model ConsultationsEntity

<form method="post" asp-action="Edit">
    <inout asp-for="Id" hidden />
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-black">Modify Consultations Details</h2>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="description"></label>
                <input asp-for="description" class="form-control" />
                <span asp-validation-for="description" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="student_id"></label>
                <input asp-for="student_id" class="form-control" />
                <span asp-validation-for="student_id" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="instructor_id"></label>
                <input asp-for="instructor_id" class="form-control" />
                <span asp-validation-for="instructor_id" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="date"></label>
                <input asp-for="date" class="form-control" />
                <span asp-validation-for="date" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-primary" value="Save details" />
            <a asp-action="CnosultationsManagement" class="btn btn-primary mx-1">Back To List</a>
        </div>
    </div>
</form>