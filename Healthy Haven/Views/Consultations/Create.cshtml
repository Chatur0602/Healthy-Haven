@using Healthy_Haven.Data;
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _db;
@model IEnumerable<ConsultationsEntity>

@{
    ViewData["Title"] = "Consultations Management";

    var userId = UserManager.GetUserId(User); // Use the appropriate way to get the current user's identity
    System.Diagnostics.Debug.WriteLine(userId);
    var isMemberOrInstructor = User.IsInRole("Instructor") || User.IsInRole("Member");

    IEnumerable
    <ForumModel> filteredConsultations;

    if (isMemberOrInstructor)
    {
        filteredConsultations = Model.Where(f => f.User_Id == userId.ToString());
    }
    else
    {
        // Filter forums based on the current user's identity
        filteredConsultations = Model;
    }
}

<div>
    @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
    {
    <div class="row pt-4">
        <div class="col-9">
            <h2>Admin|Mod Forum Management Dashboard</h2>
        </div>
    </div>
    <br />
    <table class="table table-bordered table table-striped" width="100%">
        <thead>
            <tr>
                <th>Forum Id</th>
                <th>Description</th>
                <th>Member</th>
                <th>Instructor</th>
                <th>DateTime</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var user = _db.Users.Find(item.User_Id);
                var firstName = user.FirstName;
                var lastName = user.LastName;

                <tr>
                    <td width="15%">@item.Id</td>
                    <td width="15%">@item.Title</td>
                    <td width="20%">@item.Description</td>
                    <td width="15%">@item.User_Id (@firstName @lastName)</td>
                    <td width="5%">@item.Created_At</td>
                    <td width="20%">
                        <div class="w-100 btn-group" role="group">
                            <a asp-controller="Forum" asp-action="DeleteForum" asp-route-Id="@item.Id"
                               class="btn btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }  else if(User.IsInRole("Instructor") || User.IsInRole("Member")){
    <div class="row pt-4">
        <div class="col-9">
            <h2>Personal Forum Management Dashboard</h2>
        </div>
    </div>
    <br />
    <div class="col-12 text-lg-end">
        <a asp-controller="Forum" asp-action="CreateForum" class="btn btn-success">Let's Talk!</a>
    </div>
    <br />
    <table class="table table-bordered table table-striped" width="100%">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in filteredConsultations)
            {
                <tr>
                    <td width="15%">@item.Title</td>
                    <td width="20%">@item.Description</td>
                    <td width="5%">@item.Created_At</td>
                    <td width="20%">
                        <div class="w-100 btn-group" role="group">
                            <a asp-controller="Forum" asp-action="EditForum" asp-route-Id="@item.Id"
                               class="btn btn-primary mx-1">Edit</a>
                            <a asp-controller="Forum" asp-action="DeleteForum" asp-route-Id="@item.Id"
                               class="btn btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    }
</div>


<form method="post" asp-controller="Consultations" asp-action="Create">
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-black">Add Consultations Details</h2>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="description">Description</label>
                <input asp-for="description" class="form-control"/>
                <span asp-validation-for="description" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="student_id">Student</label>
                <select asp-for="student_id" class="form-control" asp-items="@ViewBag.Members"></select>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="instructor_id">Instructor</label>
                <select asp-for="instructor_id" class="form-control" asp-items="@ViewBag.Instructors"></select>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="date">Date</label>
                <input asp-for="date" class="form-control" />
                <span asp-validation-for="date" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-primary" value="Save details"/>
            <a asp-action="ConsultationsManagement" class="btn btn-primary mx-1">Back To List</a>
        </div>
    </div>
</form>