@model ConsultationsEntity

<form method="post" asp-controller="Consultations" asp-action="Create">
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-black">Add Consultations Details</h2>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="description"></label>
                <input asp-for="description" class="form-control"/>
                <span asp-validation-for="description" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                @* <label asp-for="student_id"></label>
                @Html.DropDownListFor(model => model.student_id, new SelectList(ViewBag.Members, "Value", "Text"), "Select Member", new { @class = "form-control" })
                <span asp-validation-for="student_id" class="text-danger"></span> *@

                <select asp-for="student_id" class="form-control" asp-items="@ViewBag.Members"></select>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                @* <label asp-for="instructor_id"></label>
                @Html.DropDownListFor(model => model.instructor_id, new SelectList(ViewBag.Instructors, "Value", "Text"), "Select Instructor", new { @class = "form-control" })
                <span asp-validation-for="instructor_id" class="text-danger"></span> *@

                <select asp-for="instructor_id" class="form-control" asp-items="@ViewBag.Instructors"></select>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="date"></label>
                <input asp-for="date" class="form-control" />
                <span asp-validation-for="date" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-primary" value="Save details"/>
            <a asp-action="ConsultationsManagement" class="btn btn-primary mx-1">Back To List</a>
        </div>
    </div>
</form>