@{
}
@model IEnumerable<ConsultationsEntity>

<div>
    <div class="row pt=4">
        <div class="col-9">
            <h2 class="text-success">View All Consultations</h2>
        </div>
        <div class="col-12 text-lg-end">
            <a asp-controller="Home" asp-action="Create" class="btn btn-primary">Add Consultation</a>
        </div>
    </div>
    <br />
    @if (Model !=null && Model.Count() > 0)
    {
        <table class="table table-bordered table-hover table-striped" width="100%">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Student</th>
                    <th>Instructor</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model)
                {
                    <tr>
                        <td width="20%">@item.description</td>
                        <td width="20%">@item.student_id</td>
                        <td width="20%">@item.instructor_id</td>
                        <td width="20%">@item.date</td>
                        <td width="20%">@item.time</td>
                        <td width="30%">
                            <div class="w-100 btn-group" role="group">
                                <a asp-controller="Home" asp-action="Edit" asp-route-Id="@item.Id"
                                class="btn btn-primary mx-1">Edit</a>
                                <a asp-controller="Home" asp-action="Delete" asp-route-Id="@item.Id"
                                   class="btn btn-danger mx-1">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>
