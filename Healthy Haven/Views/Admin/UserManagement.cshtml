@using Microsoft.AspNetCore.Identity
@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "User Management";
}

<div>
    <div class="row pt-4">
        <div class="col-9">
            <h2 class="text-success">Admin User Management Dashboard</h2>
        </div>
    </div>
    <br />
    @if (Model != null && Model.Count() > 0)
    {
        <table class="table table-bordered table table-striped" width="100%">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Gender</th>
                    <th>Age</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td width="15%">@item.FirstName</td>
                        <td width="15%">@item.LastName</td>
                        <td width="20%">@item.Email</td>
                        <td width="20%">@item.PhoneNumber</td>
                        <td width="5%">@item.Gender</td>
                        <td width="5%">@item.Age</td>
                        <td width="20">
                            <div class="w-100 btn-group" role="group">
                                <a asp-controller="Admin" asp-action="DeleteUser" asp-route-Id="@item.Id"
                                   class="btn btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>