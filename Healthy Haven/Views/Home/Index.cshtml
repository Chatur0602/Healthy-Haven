@{
    ViewData["Title"] = "Home";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Healthy Haven</title>

    <!-- Add your CSS styles or link to an external stylesheet here -->
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            text-align: center;
        }

        h1 {
            margin-top: 50px;
        }

        #introVideo {
            width: 70%; /* Adjust the width as needed */
            max-width: 800px; /* Set a maximum width if desired */
            margin: 20px auto;
            /* Add additional styling for the video container */
        }

        video {
            width: 100%;
            height: 500px; /* Adjust the height as needed */
            object-fit: cover; /* Maintain video aspect ratio and cover the container */
        }
    </style>
</head>

<body>

    <h1>Welcome To Healthy Haven</h1>

    <div id="introVideo">
        <video width="100%" height="400" controls autoplay muted controlsList="nodownload">
            <source src="/IntroVideo.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>
    </div>

</body>
