@model IEnumerable<OptionsModel>
@{
    ViewData["Title"] = "OptionManagement";
}

<style>
    .table th, .table td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-height: 3em;
        max-width: 200px; /* Set your desired maximum width */
    }

    tbody tr:hover td:first-child {
        cursor: pointer;
        background-color: #DAA520;
        box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.2);
        transform: scale3d(1.05, 1.05, 1) origin(right, bottom);
        overflow: hidden;
        font-weight: bold;
        color: #FFFFFF;
    }
</style>

<div>
    <div class="row pt-4">
        <h2 class="col-9">Options Management Menu</h2>
    </div>
    <div class="col-12 text-lg-end">
        <!-- Add button for creating a new quiz -->
        <a asp-controller="Quiz" asp-action="InstructorModeratorQuizManagement" class="btn btn-success">Return to Dashboard</a>
    </div>
</div>

<br />

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-hover table-striped" width="100%">
        <thead>
            <tr>
                <th>Option</th>
                <th>Answer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var options in Model)
            {
                <tr data-question-id="@options.Id">
                    <td width="40%">@options.OptionText</td>
                    <td width="40%">@options.IsCorrect</td>
                </tr>
            }
        </tbody>
    </table>
    <br />
    <div class="text-start">
        <a asp-controller="Quiz" asp-action="EditOptions" asp-route-questionId="@Model.First().QuestionId" class="btn btn-warning btn-lg">Edit Options</a>
    </div>
}
else
{
    <br />
    <p class="text-lg-center"><b>No Options Found</b></p>
}

