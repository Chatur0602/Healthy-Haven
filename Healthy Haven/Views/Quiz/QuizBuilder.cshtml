
@{
    ViewData["Title"] = "QuizBuilder";
}


<h1>QuizBuilder</h1>

<div id="quiz-builder">
    <div id="build-wrap"></div>

    <div id="form-preview"></div>

    <button id="submit-form" class="btn btn-primary">Submit Quiz</button>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.11.4/jquery-ui.min.js"></script>

<script src="https://formbuilder.online/assets/js/form-builder.min.js"></script>

<script src="https://formbuilder.online/assets/js/form-render.min.js"></script>



<script>
    jQuery($ => {
        const fbTemplate = document.getElementById('build-wrap');
        const formBuilder = $(fbTemplate).formBuilder();

        // Render the form whenever the form structure changes
        formBuilder.on('formChanged', () => {
            const renderedForm = formBuilder.data;
            const formPreview = document.getElementById('form-preview');
            formPreview.innerHTML = ''; // Clear previous form preview

            // Render the form structure into the preview section
            formBuilder.render(formPreview);
        });

        // Handle form submission
        const submitButton = document.getElementById('submit-form');
        submitButton.addEventListener('click', () => {
            const formData = formBuilder.data;
            // Submit form data to a server-side script or API here
            console.log('Form Data:', formData);
        });
    });
</script>