@{
    ViewData["Title"] = "QuizBuilder";
}

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/smoothness/jquery-ui.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/rateYo/2.2.0/jquery.rateyo.min.css">

    <style>
        /* Inline CSS code here */
        body {
            font-family: Arial, sans-serif;
        }

        #quiz-builder {
            /* Add your styling for the quiz-builder container */
        }

        /* Add more styles as needed */
    </style>
</head>

<body>
    <div id="quiz-builder">
        <div id="build-wrap">
        </div>

        <div id="form-preview">
        </div>

        <button id="submit-form" class="btn btn-primary">Submit Quiz</button>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.11.4/jquery-ui.min.js"></script>

    <!-- Make sure formBuilder is loaded after jQuery -->
    <script src="https://formbuilder.online/assets/js/form-builder.min.js"></script>
    <script src="https://formbuilder.online/assets/js/form-render.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/rateYo/2.2.0/jquery.rateyo.min.js"></script>

    <script>
        // Wrap your script in a jQuery ready function
        $(document).ready(function () {
            // Log to the console to ensure jQuery is loaded
            console.log('jQuery version:', $.fn.jquery);

            // Try to load formBuilder after jQuery
            try {
                const fbTemplate = document.getElementById('build-wrap');

                // Log a message to check if this code is reached
                console.log('Before formBuilder initialization');

                // Use the correct initialization method
                $(fbTemplate).formBuilder();

                // Log a message after formBuilder initialization
                console.log('After formBuilder initialization');

                // ... rest of the code ...

            } catch (error) {
                // Log any errors to the console
                console.error('Error initializing formBuilder:', error);
            }
        });
    </script>
</body>
</html>
