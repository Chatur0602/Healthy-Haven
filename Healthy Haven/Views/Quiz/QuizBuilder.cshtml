@model Healthy_Haven.Models.QuestionsModel

@{
    ViewData["Title"] = "Quiz Builder";
}

<h2>Quiz Builder</h2>

<h3>Create New Question ID = @Model.QuizId</h3>

<form asp-action="AddQuestion" method="post">
    <input type="hidden" name="quizId" value="@Model.QuizId">

    <div class="form-group">
        <label for="QuestionText">Question:</label>
        <textarea asp-for="QuestionText" class="form-control" required></textarea>
        @Html.ValidationMessageFor(model => model.QuestionText)
    </div>

    <div class="form-group">
        <h4>Options:</h4>

        <div id="optionList"></div>

        <button type="button" class="btn btn-primary" id="addOption">Add Option</button>
    </div>

    <button type="submit" class="btn btn-success">Add Question</button>
</form>

@section scripts {
    <script>
        $(document).ready(function () {
            var optionCounter = 1;

            $('#addOption').click(function () {
                // Generate HTML for the new option field
                var optionHtml = '<div class="option-group">' +
                    '<label for="Options[' + optionCounter + '].OptionText">Option Text:</label>' +
                    '<input type="text" asp-for="Options[' + optionCounter + '].OptionText" class="form-control" required>' +
                    '<label for="Options[' + optionCounter + '].IsCorrect">Is Correct:</label>' +
                    '<input type="checkbox" asp-for="Options[' + optionCounter + '].IsCorrect" class="form-check-input">' +
                    '</div>';

                // Append the new option field to the option list
                $('#optionList').append(optionHtml);

                optionCounter++;
            });
        });
    </script>
}