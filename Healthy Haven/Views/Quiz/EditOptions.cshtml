@model Healthy_Haven.Models.QuestionsModel

@{
    ViewData["Title"] = "EditOptions";
}



<h2>Question: @Model.QuestionText</h2>
<br />
<h3>Add Options</h3>




<div>
    <label for="OptionText">Option:</label>
    <input type="text" id="optionText" class="form-control" required>
    <span class="text-danger" id="emptyOptionError" style="display:none;">Please enter a non-empty option.</span>
    <span class="text-danger" id="maxOptionsError" style="display:none;">You can add a maximum of 4 options.</span>
    <span class="text-danger" id="minOptionsError" style="display:none;">Please add at least 2 options.</span>
</div>

<button type="button" class="btn btn-warning mt-3" id="addOption">Add Option</button>

<div id="optionList" class="mt-3">
    <!-- Existing options (if any) can be displayed here -->
</div>


<a asp-controller="Quiz" asp-action="OptionManagement" asp-route-questionId="@Model.Id" class="btn btn-danger mt-3">Cancel</a>
<button type="button" class="btn btn-success mt-3" id="editOptions">Submit</button>


@section scripts {
    <script>
        $(document).ready(function () {
            var options = [];

            function gatherOptions() {
                var gatheredOptions = [];

                $('#optionList input[type="radio"]').each(function () {
                    var option = {
                        QuestionId: @Model.Id, // Assuming QuestionId is available in the view
                        OptionText: $(this).val(),
                        IsCorrect: $(this).is(':checked')
                    };

                    gatheredOptions.push(option);
                });

                return gatheredOptions;
            }

            $('#addOption').click(function () {
                var optionText = $('#optionText').val().trim();

                if (optionText !== "") {
                    if ($('#optionList input[type="radio"]').length < 4) {
                        var radioButton = $('<input type="radio">').attr({
                            name: 'options',
                            value: optionText
                        });

                        var label = $('<label>').text(optionText);

                        $('#optionList').append(radioButton).append(label).append('<br>');

                        $('#optionText').val("");
                        $('#emptyOptionError').hide();
                        $('#maxOptionsError').hide();
                        $('#minOptionsError').hide();
                    } else {
                        $('#maxOptionsError').show();
                    }
                } else {
                    $('#emptyOptionError').show();
                }
            });

            $('#editOptions').click(function () {
                if ($('#optionList input[type="radio"]').length >= 2) {
                    if ($('#optionList input[type="radio"]:checked').length > 0) {
                        options = gatherOptions();

                        $.ajax({
                            type: 'POST',
                            url: '/Quiz/EditOptions',
                            contentType: 'application/json; charset=utf-8',
                            data: JSON.stringify(options),
                            success: function () {
                                alert("Options Updated Successfully!");
                                window.location.href = '/Quiz/OptionManagement?questionId=@Model.Id';
                            },
                            error: function () {
                                alert("An error occurred while editing options.");
                            }
                        });
                    } else {
                        alert("Please select an answer as correct.");
                    }
                } else {
                    $('#minOptionsError').show();
                }
            });

        });

    </script>
}

