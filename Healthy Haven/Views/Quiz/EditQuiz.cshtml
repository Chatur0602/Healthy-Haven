@model Healthy_Haven.Models.QuizCoursesModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@using System.Security.Claims;

@{
    ViewData["Title"] = "EditQuiz";
}

<div>
    <h3>Current Quiz Details</h3>
    <hr />
    <dl class="row">
        <dt class="col-xl-1">Title:</dt>
        <dd class="col-xl-11">@Model.Quizzes.Title</dd>

        <dt class="col-xl-1">Description:</dt>
        <dd class="col-xl-11">@Model.Quizzes.Description</dd>

        <dt class="col-xl-1">Course:</dt>
        <dd class="col-xl-11">@Model.CoursesList.FirstOrDefault(c => c.id == Model.Quizzes.CourseId)?.name</dd>

    </dl>
</div>

<hr />
<br />

<h3>Edit Quiz</h3>

<form asp-action="EditQuizDetails" method="post">
    @Html.ValidationSummary(true)

    <div class="form-group">
        <label asp-for="Quizzes.Title"></label>
        <input asp-for="Quizzes.Title" class="form-control" required />
        @Html.ValidationMessageFor(model => model.Quizzes.Title)
    </div>

    <div class="form-group">
        <label asp-for="Quizzes.Description"></label>
        <textarea asp-for="Quizzes.Description" class="form-control" required></textarea>
        @Html.ValidationMessageFor(model => model.Quizzes.Description)
    </div>

    <!-- Hidden fields for additional details -->
    <input type="hidden" asp-for="Quizzes.UserId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
    <input type="hidden" asp-for="Quizzes.Id" value="@Model.Quizzes.Id" />
    <input type="hidden" asp-for="Quizzes.Date" value="@Model.Quizzes.Date" />

    <div class="form-group">
        <label asp-for="Quizzes.CourseId">Select Course:</label>
        <select asp-for="Quizzes.CourseId" class="form-control" required>
            <option value="">Select Course</option>
            @if (Model.CoursesList != null)
            {
                var userId = UserManager.GetUserId(User);
                foreach (var course in Model.CoursesList.Where(c => c.instructor_id == userId.ToString()))
                {
                    <option value="@course.id" selected="@course.id == Model.Quizzes.CourseId">@course.name</option>
                }
            }
        </select>
        @Html.ValidationMessageFor(model => model.Quizzes.CourseId)
    </div>

    <div class="form-group">
        <br />
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-controller="Quiz" asp-action="InstructorModeratorQuizManagement" class="btn btn-danger">Cancel</a>
    </div>
</form>
