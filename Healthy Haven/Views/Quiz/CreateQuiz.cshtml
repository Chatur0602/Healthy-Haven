@model Healthy_Haven.Models.QuizCoursesModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@using System.Security.Claims;


@{
    ViewData["Title"] = "Create Quiz";
}

<h2>Create a New Quiz</h2>
<br />

<form asp-action="CreateQuiz" method="post">
    @Html.ValidationSummary(true) <!-- Display summary of validation errors -->

    <div class="form-group">
        <label for="Title">Quiz Title:</label>
        <input asp-for="Quizzes.Title" class="form-control" required>
        @Html.ValidationMessageFor(model => model.Quizzes.Title) <!-- Display validation error for Title -->
    </div>

    <br />
    <div class="form-group">
        <label for="Description">Quiz Description:</label>
        <textarea asp-for="Quizzes.Description" class="form-control" required></textarea>
        @Html.ValidationMessageFor(model => model.Quizzes.Description) <!-- Display validation error for Description -->
    </div>

    <br />
    <!-- Add dropdown for selecting courses -->
    <div class="form-group">
        <label for="CourseId">Select Course:</label>
        <select asp-for="Quizzes.CourseId" class="form-control" required>
            <option value="">Select Course</option>

            @if (Model.CoursesList != null)
            {
                var userId = UserManager.GetUserId(User);
                foreach (var course in Model.CoursesList.Where(c => c.instructor_id == userId.ToString()))
                {
                    <option value="@course.id">@course.name</option>
                }
            }
        </select>
        @Html.ValidationMessageFor(model => model.Quizzes.CourseId)
    </div>

    <!-- Hidden fields for additional details -->
    <input type="hidden" asp-for="Quizzes.UserId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
    <input type="hidden" asp-for="Quizzes.Date" value="@DateTime.Now" />

    <!-- Add more fields as needed -->
    <br />
    <button type="submit" class="btn btn-primary">Create Quiz</button>
</form>
