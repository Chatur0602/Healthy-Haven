@using Healthy_Haven.Data;
@inject ApplicationDbContext _db;
@model QuizzesModel;
@{
    ViewData["Title"] = "QuizRender";
}


<style>
    body {
        color: goldenrod;
        font-family: 'Arial', sans-serif;
        margin: 20px;
    }

    .details-section {
        background-color: #ffc107;
        color: #ffffff;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    .details-column {
        width: 48%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .question-section {
        background-color: #fff6c9;
        color: #132B25;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    h1, h3 {
        margin: 0;
        color: #132B25;
    }

    h3 {
        margin-bottom: 10px;
    }

    form {
        margin-top: 20px;
    }

    label {
        display: block;
        margin-bottom: 5px;
        font-size: 0.9em;
    }

    p{
        text-indent : 30px;
        color: #000000;
        font-size: 12pt;
    }

    input[type="radio"] {
        margin-right: 10px;
        appearance: none; /* Hide default radio button style */
        width: 15px;
        height: 15px;
        border: 2px solid #132B25;
        border-radius: 50%;
        background-color: #fff;
        cursor: pointer;
    }

        input[type="radio"]:checked {
            background-color: goldenrod;
        }

        input[type="radio"]:hover {
            border-color: #132B25;
        }
</style>

<div class="details-section">
    <h1 class="text-center">@Model.Title</h1>
    <br />
    <h3>Description: @Model.Description</h3>
    <h3>Author:      @_db.Users.Find(Model.UserId)?.FirstName @_db.Users.Find(Model.UserId)?.LastName</h3>
    <h3>Course:      @_db.Courses.Find(Model.CourseId)?.name</h3>
</div>


<form asp-action="QuizResult" method="post">
    <input type="hidden" name="quizId" value="@Model.Id" />
    <input type="hidden" name="totalQuestions" value="@(_db.Questions.Where(q => q.QuizId == Model.Id).Count())" />

    @{
        var questions = _db.Questions.Where(q => q.QuizId == Model.Id).ToList();
    }

    @foreach (var question in questions)
    {
        <div class="question-section">
            <label class="lead">@question.QuestionText</label>

            @{
            var options = _db.Options.Where(o => o.QuestionId == question.Id).ToList();

            }
            @foreach (var option in options)
            {
                <p class="text-muted">
                    <input type="radio" name="QuestionResponses[@question.Id]" value="@option.Id" />
                    @option.OptionText
                </p>
            }
        </div>
    }

    <button class="btn btn-warning btn-lg" type="submit">Submit Quiz</button>
</form>

<script>
    function validateForm() {
        var questions = document.querySelectorAll('[name^="QuestionResponses["]');
        for (var i = 0; i < questions.length; i++) {
            var selectedOptions = document.querySelectorAll('[name="' + questions[i].name + '"]:checked');
            if (selectedOptions.length === 0) {
                alert('Please select an option for each question before submitting.');
                return false; // Prevent form submission
            }
        }
        return true; // Allow form submission
    }
</script>
