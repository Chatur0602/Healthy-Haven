@model Healthy_Haven.Models.QuestionsModel

@{
    ViewData["Title"] = "Add Options";
}

<h2>Add Options</h2>

<h3>Question ID: @Model.Id</h3>

<div>
    <label for="OptionText">Option:</label>
    <input type="text" id="optionText" class="form-control" required>
    <span class="text-danger" id="emptyOptionError" style="display:none;">Please enter a non-empty option.</span>
    <span class="text-danger" id="maxOptionsError" style="display:none;">You can add a maximum of 4 options.</span>
</div>

<button type="button" class="btn btn-primary mt-3" id="addOption">Add Option</button>

<div id="optionList" class="mt-3">
    <!-- Existing options (if any) can be displayed here -->
</div>

<button type="button" class="btn btn-success mt-3" id="saveOptions">Complete Quiz</button>
<span class="text-danger" id="minOptionsError" style="display:none;">Please add at least 2 options.</span>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#addOption').click(function () {
                var optionText = $('#optionText').val().trim();

                if (optionText !== "") {
                    // Check if the maximum number of options (4) is reached
                    if ($('#optionList input[type="radio"]').length < 4) {
                        // Create a new radio button
                        var radioButton = $('<input type="radio">').attr({
                            name: 'options',
                            value: optionText
                        });

                        // Create a label for the radio button
                        var label = $('<label>').text(optionText);

                        // Append the radio button and label to the option list
                        $('#optionList').append(radioButton).append(label).append('<br>');

                        // Clear the text in the textbox
                        $('#optionText').val("");

                        // Hide error messages
                        $('#emptyOptionError').hide();
                        $('#maxOptionsError').hide();
                        $('#minOptionsError').hide();
                    } else {
                        // Display max options error
                        $('#maxOptionsError').show();
                    }
                } else {
                    // Display empty option error
                    $('#emptyOptionError').show();
                }
            });

            $('#saveOptions').click(function () {
                // Check if at least 2 options are added
                if ($('#optionList input[type="radio"]').length >= 2) {
                    // Check if any radio button is selected
                    if ($('#optionList input[type="radio"]:checked').length > 0) {
                        // Create an array to store the options
                        var options = [];

                        // Iterate through each radio button
                        $('#optionList input[type="radio"]').each(function () {
                            var option = {
                                QuestionId: @Model.Id, // Assuming QuestionId is available in the view
                                OptionText: $(this).val(),
                                IsCorrect: $(this).is(':checked')
                            };

                            options.push(option);
                        });

                        // Send the options to the controller for processing
                        $.ajax({
                            type: 'POST',
                            url: '/Quiz/SaveOptions', // Adjust the URL based on your controller action
                            contentType: 'application/json; charset=utf-8',
                            data: JSON.stringify(options),
                            success: function () {
                                // Handle success, e.g., redirect to a success page
                                //window.location.href = "/Quiz/OptionsAddedSuccessfully";
                                alert("success");
                            },
                            error: function () {
                                // Handle error, e.g., display an error message
                                alert("An error occurred while saving options.: "+error);
                            }
                        });
                    } else {
                        // Display radio button not selected error
                        alert("Please select an answer as correct.");
                    }
                } else {
                    // Display min options error
                    $('#minOptionsError').show();
                }
            });
        });
    </script>
}