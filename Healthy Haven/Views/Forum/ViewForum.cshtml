@using Healthy_Haven.Data;
@{
    ViewData["Title"] = "View Forum";
}

@inject ApplicationDbContext _db;
@model ForumModel

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
</head>

<style>
    .image-carousel {
        width: 100%;
        height: auto; 
        margin: 0 auto;
        position: relative;
        overflow: hidden;
    }

        .image-carousel img {
            height: 400px;
            width: auto; 
            object-fit: contain;
            display: block; 
            margin: 0 auto; 
        }


    .slick-prev,
    .slick-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1 ;
        opacity: 0.8;
        color: black; 
        height: 40px; 
        border-radius: 50%;
        text-align: center;
        font-size: 24px;
        cursor: pointer;
        line-height: 1px; 
        padding-bottom: 5px; 
    }

    .slick-prev {
        left: 10px;
        background-color: darkred;
        padding-left: 3px;
    }

    .slick-next {
        right: 10px;
        background-color: darkgreen;
        padding-right: 2px;
    }

    #description {
        font-size: 20px;
        color: silver;
    }

    #posted-item{
        color: silver;
    }

    .btn-like {
        background-color: transparent;
        border: none;
        cursor: pointer;
    }

        .btn-like i {
            font-size: 1.5rem;
        }

        .btn-like .liked {
            color: red;
        }

    .heart-outline {
        color: goldenrod; 
    }

    #description,
    h2 {
        word-wrap: break-word;
    }

    .comment-text.collapsed {
        overflow: hidden;
    }

    .read-more-link {
        display: block;
        margin-top: 5px;
        color: #007bff;
        cursor: pointer;
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-12">
          
            <div class="image-carousel">
                @{
                    @using Amazon.S3;
                    @using Amazon.S3.Model;
                    @using Amazon.S3.Util;

                    var user = _db.Users.Find(Model.User_Id);
                    var firstName = user.FirstName;
                    var lastName = user.LastName;

                    var forumImages = _db.ForumImages.Where(x => x.Forum_Id == Model.Id).ToList();
                    var imagePaths = forumImages.Select(img => img.Image_Path).ToList();

                    foreach (var path in imagePaths)
                    {
                        var s3Client = new AmazonS3Client("ASIA55H4D3RU3YGBSRC2", "b9NK4j9Q1Yr06QA6pGtwSM3o27h4JqOXoby+mbV+", "", Amazon.RegionEndpoint.USEast1);

                        string bucketName = "healthyhavens3";
                        string folderName = "ForumImages";
                        string imagePath = $"{folderName}/{path}";

                        GetPreSignedUrlRequest request = new GetPreSignedUrlRequest
                        {
                            BucketName = bucketName,
                            Key = imagePath,
                            Expires = DateTime.Now.AddMinutes(60) 
                        };

                        string preSignedURL = s3Client.GetPreSignedURL(request);

                        <div>
                            <img src="@preSignedURL" alt="Image">
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-12">
            <h2>@Model.Title</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <p id="description">@Model.Description</p>
        </div>
    </div>

    @{
        var currentTime = DateTime.Now;
        var creationTime = Model.Created_At;
        var timeDifference = currentTime - creationTime;

        string timeAgo;

        if (timeDifference.TotalMinutes < 1)
        {
            timeAgo = "just now";
        }
        else if (timeDifference.TotalHours < 1)
        {
            var minutes = (int)timeDifference.TotalMinutes;
            timeAgo = $"{minutes} {(minutes == 1 ? "minute" : "minutes")} ago";
        }
        else if (timeDifference.TotalDays < 1)
        {
            var hours = (int)timeDifference.TotalHours;
            timeAgo = $"{hours} {(hours == 1 ? "hour" : "hours")} ago";
        }
        else if (timeDifference.TotalDays < 30)
        {
            var days = (int)timeDifference.TotalDays;
            timeAgo = $"{days} {(days == 1 ? "day" : "days")} ago";
        }
        else if (timeDifference.TotalDays < 365)
        {
            var months = (int)(timeDifference.TotalDays / 30);
            timeAgo = $"{months} {(months == 1 ? "month" : "months")} ago";
        }
        else
        {
            var years = (int)(timeDifference.TotalDays / 365);
            timeAgo = $"{years} {(years == 1 ? "year" : "years")} ago";
        }
    }

    <div class="row">
        <div class="col-6">
            <p id="posted-item"><strong>Posted By</strong> @firstName @lastName | @timeAgo</p>
        </div>
    </div>
    <div class="row">
        <div class="col-6 d-flex align-items-center">
            <button class="btn btn-info mx-1" onclick="shareForum('@Model.Id')">
                Share <i class="fas fa-share-alt"></i>
            </button>

            @{
                @using System.Security.Claims;

                var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                var hasLikedForum = _db.ForumLikes.Any(x => x.ForumId == Model.Id && x.UserId == userId);
                var forumLikeCount = _db.ForumLikes.Count(x => x.ForumId == Model.Id);

                if (hasLikedForum)
                {
                    <form asp-controller="Like" asp-action="UnlikeForum" method="post" class="mr-2">
                        <input type="hidden" name="forumId" value="@Model.Id" />
                        <button type="submit" class="btn btn-like">
                            <i class="fas fa-heart text-danger"></i>
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="Like" asp-action="LikeForum" method="post" class="mr-2">
                        <input type="hidden" name="forumId" value="@Model.Id" />
                        <button type="submit" class="btn btn-like">
                            <i class="far fa-heart text-warning heart-outline"></i>
                        </button>
                    </form>
                }
            }
            <h5 class="mb-0 ml-2"><span id="forumLikeCount_@Model.Id"><strong>@forumLikeCount</strong></span></h5>
        </div>
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-12">
            <h3>Comments</h3>
            @{
                var forumComments = _db.Comments.Where(x => x.ForumId == Model.Id).ToList();

                @foreach (var comment in forumComments)
                {
                    var user2 = _db.Users.Find(comment.UserId);
                    var firstName2 = user2.FirstName;
                    var lastName2 = user2.LastName;

                    <div class="card mb-3">
                        <div class="card-body comment-card">
                            <p class="comment-text" style="font-size:18px;">@comment.CommentText</p>
                        </div>
                        @{
                            var currentTime2 = DateTime.Now;
                            var creationTime2 = comment.CreatedAt;
                            var timeDifference2 = currentTime2 - creationTime2;

                            string timeAgo2;

                            if (timeDifference2.TotalMinutes < 1)
                            {
                                timeAgo2 = "just now";
                            }
                            else if (timeDifference2.TotalHours < 1)
                            {
                                var minutes = (int)timeDifference2.TotalMinutes;
                                timeAgo2 = $"{minutes} {(minutes == 1 ? "minute" : "minutes")} ago";
                            }
                            else if (timeDifference2.TotalDays < 1)
                            {
                                var hours = (int)timeDifference2.TotalHours;
                                timeAgo2 = $"{hours} {(hours == 1 ? "hour" : "hours")} ago";
                            }
                            else if (timeDifference2.TotalDays < 30)
                            {
                                var days = (int)timeDifference2.TotalDays;
                                timeAgo2 = $"{days} {(days == 1 ? "day" : "days")} ago";
                            }
                            else if (timeDifference2.TotalDays < 365)
                            {
                                var months = (int)(timeDifference2.TotalDays / 30);
                                timeAgo2 = $"{months} {(months == 1 ? "month" : "months")} ago";
                            }
                            else
                            {
                                var years = (int)(timeDifference2.TotalDays / 365);
                                timeAgo2 = $"{years} {(years == 1 ? "year" : "years")} ago";
                            }
                        }

                        <div class="card-footer d-flex align-items-center justify-content-between">
                            <p class="mb-0 mr-3"><strong>Posted By</strong> @firstName2 @lastName2 | @timeAgo2</p>
                            <div class="d-flex align-items-center">
                                @{
                                    var userId2 = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                                    var hasLikedComment = _db.CommentLikes.Any(x => x.CommentId == comment.Id && x.UserId == userId2);
                                    var likeCount = _db.CommentLikes.Count(x => x.CommentId == comment.Id);

                                    if (comment.UserId == userId2 || User.IsInRole("Moderator") || User.IsInRole("Admin"))
                                    {
                                        <form asp-controller="Comment" asp-action="DeleteComment" method="post">
                                            <input type="hidden" name="commentId" value="@comment.Id" />
                                            <input type="hidden" name="forumId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-like">
                                                <i class="fas fa-trash-alt text-danger"></i>
                                            </button>
                                        </form>
                                    }

                                    if (hasLikedComment)
                                    {
                                        <form asp-controller="Like" asp-action="UnlikeComment" method="post" class="mr-2">
                                            <input type="hidden" name="commentId" value="@comment.Id" />
                                            <input type="hidden" name="forumId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-like">
                                                <i class="fas fa-heart text-danger"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Like" asp-action="LikeComment" method="post" class="mr-2">
                                            <input type="hidden" name="commentId" value="@comment.Id" />
                                            <input type="hidden" name="forumId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-like">
                                                <i class="far fa-heart text-warning heart-outline"></i>
                                            </button>
                                        </form>
                                    }
                                }
                                <span><strong id="likeCount_@comment.Id">@likeCount</strong></span>
                            </div>
                        </div>
                    </div>

           
                }
            }
        </div>
    </div>
    <br />
    @if (User.IsInRole("Instructor") || User.IsInRole("Member") || User.IsInRole("Moderator"))
    {
        <div class="row">
            <div class="col-12">
                <h3>Add Comment</h3>
                <form id="commentForm" asp-controller="Comment" asp-action="AddComment" method="post">
                    <input type="hidden" name="forumId" value="@Model.Id" />
                    <div class="form-group">
                        <label for="commentText">Comment</label>
                        <textarea class="form-control" id="commentText" name="commentText" rows="3"></textarea>
                    </div>
                    <div id="commentError" class="text-danger" style="display: none;">Comment field cannot be empty.</div>
                    <br />
                    <button type="button" onclick="validateComment()" class="btn btn-primary">Add Comment</button>
                </form>
            </div>
        </div>
    }

    else
    {
        <h4>Please <a id="login" asp-area="Identity" asp-page="/Account/Login">Sign In</a> To Post A Comment!</h4>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var comments = document.querySelectorAll('.comment-text');

        comments.forEach(function (comment) {
            var lineHeight = parseFloat(window.getComputedStyle(comment).lineHeight);
            var maxHeight = lineHeight * 3; // Show up to 3 lines

            if (comment.clientHeight > maxHeight) {
                comment.classList.add('collapsed');
                comment.style.maxHeight = maxHeight + 'px';

                var readMoreLink = document.createElement('a');
                readMoreLink.href = 'javascript:void(0)';
                readMoreLink.classList.add('read-more-link');
                readMoreLink.textContent = 'Read more';
                readMoreLink.onclick = function () {
                    if (comment.classList.contains('collapsed')) {
                        comment.classList.remove('collapsed');
                        comment.style.maxHeight = 'none';
                        readMoreLink.textContent = 'Show less';
                    } else {
                        comment.classList.add('collapsed');
                        comment.style.maxHeight = maxHeight + 'px';
                        readMoreLink.textContent = 'Read more';
                    }
                };

                comment.parentNode.appendChild(readMoreLink);
            }
        });
    });

    // Initialize the Slick Carousel
    $('.image-carousel').slick({
        infinite: true,
        slidesToShow: 1,
        slidesToScroll: 1,
        prevArrow: '<button class="slick-prev"><-</button>',
        nextArrow: '<button class="slick-next">-></button>'
    });

    function validateComment() {
        var commentText = document.getElementById("commentText").value;
        var commentError = document.getElementById("commentError");

        if (commentText.trim() === "") {
            commentError.style.display = "block";
        } else {
            document.getElementById("commentForm").submit();
        }
    }

    function shareForum(forumId) {
        var baseUrl = 'http://healthyhaven.us-east-1.elasticbeanstalk.com';

        var forumUrl = baseUrl + '/Forum/ViewForum/' + forumId;

        var dummyInput = document.createElement('input');
        document.body.appendChild(dummyInput);
        dummyInput.value = forumUrl;
        dummyInput.select();
        document.execCommand('copy');
        document.body.removeChild(dummyInput);

        showMessage('Forum Link Copied To Clipboard!');
    }

    function showMessage(message) {

        alert(message);
    }
</script>
