@using Healthy_Haven.Data;
@{
    ViewData["Title"] = "View Forum";
}

@inject ApplicationDbContext _db;
@model ForumModel

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
</head>

<style>
    .image-carousel {
        width: 100%;
        height: auto; 
        margin: 0 auto;
        position: relative;
        overflow: hidden;
    }

        .image-carousel img {
            height: 400px;
            width: auto; 
            object-fit: contain;
            display: block; 
            margin: 0 auto; 
        }


    .slick-prev,
    .slick-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1 ;
        opacity: 0.8;
         /* Background color for the buttons */
        color: black; /* Text color for the buttons */
        width: 40px; /* Width of the buttons */
        height: 40px; /* Height of the buttons */
        border-radius: 50%; /* Make the buttons circular */
        text-align: center;
        font-size: 24px; /* Adjust the font size */
        cursor: pointer;
        line-height: 1px; /* Center the text vertically within the buttons */
        padding-bottom: 5px; /* Remove padding to keep text centered */
    }

    .slick-prev {
        left: 10px;
        background-color: darkred;
        padding-left: 3px;
    }

    .slick-next {
        right: 10px;
        background-color: darkgreen;
        padding-right: 2px;
    }

    #description {
        font-size: 20px;
        color: silver;
    }

    #posted-item{
        color: silver;
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-12">
          
            <div class="image-carousel">
                @{
                    @using Amazon.S3;
                    @using Amazon.S3.Model;
                    @using Amazon.S3.Util;

                    var user = _db.Users.Find(Model.User_Id);
                    var firstName = user.FirstName;
                    var lastName = user.LastName;

                    var forumImages = _db.ForumImages.Where(x => x.Forum_Id == Model.Id).ToList();
                    var imagePaths = forumImages.Select(img => img.Image_Path).ToList();

                    foreach (var path in imagePaths)
                    {

                        var s3Client = new AmazonS3Client("ASIA55H4D3RU2URZVY7V", "/LcSoHIdiC+FAPHAVHuWUxcPjVIctA6k4L9E8DoV", "", Amazon.RegionEndpoint.USEast1);

                        
                        string bucketName = "healthyhavens3";
                        string imagePath = path;

                        
                        GetPreSignedUrlRequest request = new GetPreSignedUrlRequest
                        {
                            BucketName = bucketName,
                            Key = imagePath,
                            Expires = DateTime.Now.AddMinutes(30) 
                        };

                        string preSignedURL = s3Client.GetPreSignedURL(request);

                        <div>
                            <img src="@preSignedURL" alt="Image">
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-12">
            <h2>@Model.Title</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <p id="description">@Model.Description</p>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <p id="posted-item"><strong>Posted By</strong> @firstName @lastName | <strong>Posted On</strong> @Model.Created_At</p>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            @{
                @using System.Security.Claims;

                var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                var hasLikedForum = _db.ForumLikes.Any(x => x.ForumId == Model.Id && x.UserId == userId);

                if (hasLikedForum)
                {
                    <form asp-controller="Like" asp-action="UnlikeForum" method="post">
                        <input type="hidden" name="forumId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary">Unlike Forum</button>
                    </form>
                }
                else
                {
                    <form asp-controller="Like" asp-action="LikeForum" method="post">
                        <input type="hidden" name="forumId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary">Like Forum</button>
                    </form>
                }
            }
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <h3>Comments</h3>
            <!-- Display existing comments -->
            @{
            var forumComments = _db.Comments.Where(x => x.ForumId == Model.Id).ToList();
            
            foreach (var comment in forumComments){

                var user2 = _db.Users.Find(comment.UserId);
                var firstName2 = user2.FirstName;
                var lastName2 = user2.LastName;

                <div class="card mb-3">
                    <div class="card-body">
                        <p style="font-size:18px;">@comment.CommentText</p>
                    </div>
                        <div class="card-footer d-flex align-items-center">
                            @{

                                var userId2 = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                                var hasLikedComment = _db.CommentLikes.Any(x => x.CommentId == comment.Id && x.UserId == userId2);

                                if (hasLikedComment)
                                {
                                    <form asp-controller="Like" asp-action="UnlikeComment" method="post" class="mr-2">
                                        <input type="hidden" name="commentId" value="@comment.Id" />
                                        <input type="hidden" name="forumId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-primary">Unlike Comment</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Like" asp-action="LikeComment" method="post" class="mr-2">
                                        <input type="hidden" name="commentId" value="@comment.Id" />
                                        <input type="hidden" name="forumId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-primary">Like Comment</button>
                                    </form>
                                }
                            }
                            &nbsp;&nbsp;&nbsp;<p class="mb-0"><strong>Posted By</strong> @firstName2 @lastName2 | <strong>Posted On</strong> @comment.CreatedAt</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    @if (User.IsInRole("Instructor") || User.IsInRole("Member") || User.IsInRole("Moderator"))
    {
        <div class="row">
            <div class="col-12">
                <h3>Add Comment</h3>
                <!-- Add a form to create a new comment -->
                <form asp-controller="Comment" asp-action="AddComment" method="post">
                    <input type="hidden" name="forumId" value="@Model.Id" />
                    <div class="form-group">
                        <label for="commentText">Comment</label>
                        <textarea class="form-control" id="commentText" name="commentText" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Comment</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <h4>Please <a id="register" asp-area="Identity" asp-page="/Account/Register">Sign Up</a> To Post A Comment!</h4>
    }
</div>

<script>
    // Initialize the Slick Carousel
    $('.image-carousel').slick({
        infinite: true,
        slidesToShow: 1,
        slidesToScroll: 1,
        prevArrow: '<button class="slick-prev"><-</button>',
        nextArrow: '<button class="slick-next">-></button>'
    });
</script>
