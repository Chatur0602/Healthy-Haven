@using Healthy_Haven.Data;
@{
    ViewData["Title"] = "Forum Dashboard";
}
@inject ApplicationDbContext _db;
@model IEnumerable<ForumModel>


<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
</head>


<style>
  
    .image-carousel {
        width: 100%;
        height: auto;
        margin: 0 auto;
        position: relative; 
    }

        .image-carousel img {
            height: 200px;
            width: 100%;
            object-fit: contain;
        }

    .card {
        width: 100%;
        border: 2px solid goldenrod;
        background-color: lightgrey;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .card-title{
        color: darkgoldenrod;
        font-size: 28px;
    }

    .card-text{
        font-size:20px;
    }

    .slick-dots {
        display: flex !important;
        justify-content: center !important;
        flex-direction: row !important;
        align-items: center !important;
    }

        .slick-dots li {
            margin: 0 5px !important;
            cursor: pointer ;
            color: darkgreen !important;
        }

        .slick-dots li:hover{
            color: darkgoldenrod !important;
        }

    .slick-dots li button {
        display: none !important;
    }

        /* Add a CSS class for the fading effect */
    .fade-out {
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 5; /* Limit to 5 lines */
        -webkit-box-orient: vertical;
    }

    .fade-out-title{
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 3; /* Limit to 5 lines */
        -webkit-box-orient: vertical;
    }

    .tile-icon {
        width: 33px; /* Adjust the width as needed */
        height: 33px; /* Adjust the height as needed */
        filter: invert(1);
        padding-right: 3px;
    }

    .forum-details {
        display: flex;
        margin-top: 12px;
        margin-bottom: 0; /* Remove bottom margin */
    }

    .spacer {
        flex-grow: 1;
    }
</style>

<div>
    <div class="row pt-4">
        <div class="col-9">
            <h2>Forum Dashboard</h2>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <form asp-action="ForumDashboard" method="get">
                <div class="input-group mb-3">
                    <select class="form-select" name="sortBy" onchange="this.form.submit()">
                        <option value="" selected disabled>Sort By</option>
                        <option value="newToOld">New to Old</option>
                        <option value="oldToNew">Old to New</option>
                        <option value="likesLeastToMost">Likes: Least to Most</option>
                        <option value="likesMostToLeast">Likes: Most to Least</option>
                    </select>
                </div>
            </form>
        </div>
        <div class="col-md-6 offset-md-1">
            <form asp-action="ForumDashboard" method="get">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" placeholder="Search" name="searchTerm" value="@ViewBag.SearchTerm">
                    <button class="btn btn-primary" type="submit">Search</button>
                </div>
            </form>
        </div>
        <div class="col-md-3 text-lg-end">
            @if (User.IsInRole("Instructor") || User.IsInRole("Member"))
            {
                <a asp-controller="Forum" asp-action="ForumManagement" class="btn btn-success">Manage Your Forums</a>
            }
            else if (User.IsInRole("Moderator") || User.IsInRole("Admin"))
            {
                <a asp-controller="Forum" asp-action="ForumManagement" class="btn btn-success">Manage Forums</a>
            }
        </div>
    </div>
    <br />
    <div class="row">
        @foreach (var item in Model)
        {
            var user = _db.Users.Find(item.User_Id);
            var firstName = user.FirstName;
            var lastName = user.LastName;

            var forumImages = _db.ForumImages.Where(x => x.Forum_Id == item.Id).ToList();
            var imagePaths = forumImages.Select(img => img.Image_Path).ToList();
            var forumLikeCount = _db.ForumLikes.Count(x => x.ForumId == item.Id);

            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 style="padding-bottom: 5px;" class="card-title fade-out-title">@item.Title</h5>
                        <div class="image-carousel">
                            @foreach (var path in imagePaths)
                            {
                                @using Amazon.S3;
                                @using Amazon.S3.Model;
                                @using Microsoft.Extensions.Configuration;

                                IConfiguration configuration = new ConfigurationBuilder()
                                .SetBasePath(Directory.GetCurrentDirectory())
                                .AddJsonFile("appsettings.json")
                                .Build();

                                var accessKeyId = configuration["AWSCredentials:AccessKeyId"];
                                var secretAccessKey = configuration["AWSCredentials:SecretAccessKey"];
                                var sessionToken = configuration["AWSCredentials:SessionToken"];

                                // Create an S3 client
                                var s3Client = new AmazonS3Client(accessKeyId, secretAccessKey, sessionToken, Amazon.RegionEndpoint.USEast1);

                                // Define your bucket name and image key (path)
                                string bucketName = "healthyheaven";
                                string folderName = "ForumImages";
                                string imagePath = $"{folderName}/{path}";

                                // Generate a pre-signed URL with a short expiration time
                                GetPreSignedUrlRequest request = new GetPreSignedUrlRequest
                                {
                                    BucketName = bucketName,
                                    Key = imagePath,
                                    Expires = DateTime.Now.AddMinutes(60) // Adjust the expiration time as needed
                                };

                                string preSignedURL = s3Client.GetPreSignedURL(request);
                                <div>
                                    <img src="@preSignedURL" alt="Image">
                                </div>
                            }
                        </div>
                        <p style="padding-bottom: 5px;" class="card-text fade-out">@item.Description</p>

                        @{
                            // Retrieve the top comment for the current forum
                            var topComment = _db.Comments
                            .Where(x => x.ForumId == item.Id)
                            .OrderByDescending(x => _db.CommentLikes.Count(cl => cl.CommentId == x.Id))
                            .FirstOrDefault();
                        }

                        @if (topComment != null)
                        {
                            <div class="mt-3">
                                <h5 style="color:darkgoldenrod">Top Comment</h5>
                                <div class="card">
                                    <div class="card-body">
                                        <p class="card-text fade-out-title">@topComment.CommentText</p>

                                        @{
                                            var user2 = _db.Users.Find(topComment.UserId);
                                            var firstName2 = user2.FirstName;
                                            var lastName2 = user2.LastName;

                                            var likeCount = _db.CommentLikes.Count(x => x.CommentId == topComment.Id);
                                        }

                                        <div class="d-flex justify-content-between align-items-center">
                                            <p style="font-size:14px" class="mb-0"><img src="/icons8-user-male-100.png" style="filter:invert(1) !important; height: 25px; width: 25px;" /> @firstName2 @lastName2</p>
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-heart text-danger mr-1"></i>
                                                &nbsp;
                                                <span id="likeCount_@topComment.Id"><strong style="color:goldenrod">@likeCount</strong></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Forum" asp-action="ViewForum" asp-route-Id="@item.Id" class="btn btn-primary mx-1">
                                View Forum
                            </a>

                            <div class="d-flex align-items-center">
                                <button class="btn btn-info mx-1" onclick="shareForum('@item.Id')">
                                    <i class="fas fa-share-alt"></i>
                                </button>
                                &nbsp;&nbsp;
                                <i class="fas fa-heart text-danger mr-1"></i>
                                &nbsp;
                                <h5 class="mb-0 ml-2"><span id="forumLikeCount_@item.Id"><strong>@forumLikeCount</strong></span></h5>
                            </div>
                        </div>
                        
                        @{
                            var currentTime = DateTime.Now;
                            var creationTime = item.Created_At;
                            var timeDifference = currentTime - creationTime;

                            string timeAgo;

                            if (timeDifference.TotalMinutes < 1)
                            {
                                timeAgo = "just now";
                            }
                            else if (timeDifference.TotalHours < 1)
                            {
                                var minutes = (int)timeDifference.TotalMinutes;
                                timeAgo = $"{minutes} {(minutes == 1 ? "minute" : "minutes")} ago";
                            }
                            else if (timeDifference.TotalDays < 1)
                            {
                                var hours = (int)timeDifference.TotalHours;
                                timeAgo = $"{hours} {(hours == 1 ? "hour" : "hours")} ago";
                            }
                            else if (timeDifference.TotalDays < 30)
                            {
                                var days = (int)timeDifference.TotalDays;
                                timeAgo = $"{days} {(days == 1 ? "day" : "days")} ago";
                            }
                            else if (timeDifference.TotalDays < 365)
                            {
                                var months = (int)(timeDifference.TotalDays / 30);
                                timeAgo = $"{months} {(months == 1 ? "month" : "months")} ago";
                            }
                            else
                            {
                                var years = (int)(timeDifference.TotalDays / 365);
                                timeAgo = $"{years} {(years == 1 ? "year" : "years")} ago";
                            }
                        }

                        <div class="forum-details">
                            <img src="/icons8-user-male-100.png" class="tile-icon" />
                            <p class="card-text" style="font-size: 16px; padding-top:5px; margin-bottom: 0;">@firstName @lastName</p>
                            <div class="spacer"></div> <!-- Add a spacer div for separation -->
                            <img src="/icons8-time-machine-100-white.png" class="tile-icon" />
                            <p class="card-text" style="font-size: 16px; padding-top:5px; margin-bottom: 0;">@timeAgo</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    var forums = document.querySelectorAll('.card');
    for (var i = 0; i < forums.length; i++) {
        var carouselImages = forums[i].querySelectorAll('.image-carousel img');
        if (carouselImages.length > 1) {
            $(forums[i]).find('.image-carousel').slick({
                infinite: true,
                slidesToShow: 1,
                slidesToScroll: 1,
                dots: true, // Add dots
                autoplay: true, // Enable autoplay
                autoplaySpeed: 5000, // Set autoplay speed to 3 seconds
                prevArrow: false, // Hide the previous arrow
                nextArrow: false // Hide the next arrow
            });
        }
    }

    function shareForum(forumId) {
        var baseUrl = 'http://healthyhaven.us-east-1.elasticbeanstalk.com';

        var forumUrl = baseUrl + '/Forum/ViewForum/' + forumId;

        var dummyInput = document.createElement('input');
        document.body.appendChild(dummyInput);
        dummyInput.value = forumUrl;
        dummyInput.select();
        document.execCommand('copy');
        document.body.removeChild(dummyInput);

        showMessage('Forum Link Copied To Clipboard!');
    }

    function showMessage(message) {
        
        alert(message);
    }
</script>