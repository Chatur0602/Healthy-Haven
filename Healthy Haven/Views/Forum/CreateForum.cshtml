@model ForumModel

@{
    ViewData["Title"] = "Create Forum";
}

<head>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
</head>

<div class="container">
    <form method="post" asp-action="CreateForum" enctype="multipart/form-data" id="createForumForm" class="mt-5">
        <div class="border p-5">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group row">
                <h2 class="col-12 text-center mb-4">Start A New Forum Topic</h2>
            </div>
            <div class="row">
                <div class="col-md-6 offset-md-3">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" id="Title" />
                    <span id="titleError" class="text-danger">@ViewBag.TitleError</span>
                </div>
            </div>
            <br />
            <div class="row mt-3">
                <div class="col-md-6 offset-md-3">
                    <label asp-for="Description">Description</label>
                    <div id="editor" style="height: 150px;"></div>
                    <input asp-for="Description" name="Description" class="form-control" id="description" hidden/>
                    <span id="descriptionError" class="text-danger">@ViewBag.DescriptionError</span>
                </div>
            </div>
            <br />
            <div class="row mt-3">
                <div class="col-md-6 offset-md-3">
                    <label for="files">Select Images</label>
                    <input type="file" name="files" id="files" multiple />
                    <span id="fileError" class="text-danger">@ViewBag.Error</span>
                </div>
            </div>
            <br />
            <div class="row mt-3">
                <div class="col-md-6 offset-md-3">
                    <div class="btn-group" role="group">
                        <input type="button" class="btn btn-success" value="Add New Topic" onclick="validateForumForm()" />
                        <a asp-controller="Forum" asp-action="ForumManagement" class="btn btn-primary mx-1">Back To List</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    var quill = new Quill('#editor', {
        theme: 'snow' // Specify the theme, you can change it to 'bubble' for a different appearance
    });


    function validateForumForm() {
        var title = document.getElementById("Title").value;

        fileError.innerHTML = "";

        var isValid = true;

        if (title.trim() === "") {
            document.getElementById("titleError").innerHTML = "Title cannot be empty.";
            isValid = false;
        } else {
            document.getElementById("titleError").innerHTML = "";
        }

        if (isValid) {
            document.getElementById('description').value = quill.root.innerHTML;
            document.getElementById("createForumForm").submit();
        }
    }
</script>