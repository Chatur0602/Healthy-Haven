@model ForumModel

@{
    ViewData["Title"] = "Create Forum";
}

<div class="container">
    <form method="post" asp-action="CreateForum" enctype="multipart/form-data" id="createForumForm" class="mt-5">
        <div class="border p-5">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group row">
                <h2 class="col-12 text-center mb-4">Start A New Forum Topic</h2>
            </div>
            <div class="row">
                <div class="col-md-6 offset-md-3">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" id="Title" />
                    <span id="titleError" class="text-danger">@ViewBag.TitleError</span>
                </div>
            </div>
            <br />
            <div class="row mt-3">
                <div class="col-md-6 offset-md-3">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control" style="height: 150px;"></textarea>
                    <span id="descriptionError" class="text-danger">@ViewBag.DescriptionError</span>
                </div>
            </div>
            <br />
            <div class="row mt-3">
                <div class="col-md-6 offset-md-3">
                    <label for="files">Select Images</label>
                    <input type="file" name="files" id="files" multiple />
                    <span id="fileError" class="text-danger">@ViewBag.FileError</span>
                </div>
            </div>
            <br />
            <div class="row mt-3">
                <div class="col-md-6 offset-md-3">
                    <div class="btn-group" role="group">
                        <input type="button" class="btn btn-success" value="Add New Topic" onclick="validateForumForm()" />
                        <a asp-controller="Forum" asp-action="ForumManagement" class="btn btn-primary mx-1">Back To List</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function validateForumForm() {
        var title = document.getElementById("Title").value;
        var description = document.getElementById("Description").value;

        fileError.innerHTML = "";

        var isValid = true;

        if (title.trim() === "") {
            document.getElementById("titleError").innerHTML = "Title cannot be empty.";
            isValid = false;
        } else {
            document.getElementById("titleError").innerHTML = "";
        }

        if (description.trim() === "") {
            document.getElementById("descriptionError").innerHTML = "Description cannot be empty.";
            isValid = false;
        } else {
            document.getElementById("descriptionError").innerHTML = "";
        }

        if (isValid) {
            document.getElementById("createForumForm").submit();
        }
    }
</script>