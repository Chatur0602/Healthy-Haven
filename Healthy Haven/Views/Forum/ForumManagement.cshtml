@using Healthy_Haven.Data;
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _db;
@model IEnumerable<ForumModel>

@{
    ViewData["Title"] = "Forum Management";

    var userId = UserManager.GetUserId(User); // Use the appropriate way to get the current user's identity
    System.Diagnostics.Debug.WriteLine(userId);
    var isMemberOrInstructor = User.IsInRole("Instructor") || User.IsInRole("Member");

    IEnumerable
    <ForumModel> filteredForums;

    if (isMemberOrInstructor)
    {
        filteredForums = Model.Where(f => f.User_Id == userId.ToString());
    }
    else
    {
        // Filter forums based on the current user's identity
        filteredForums = Model;
    }
}

<style>
    .table th, .table td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-height: 3em;
        max-width: 200px; /* Set your desired maximum width */
    }
</style>

<div>
    @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
    {
    <div class="row pt-4">
        <div class="col-9">
            <h2>Admin|Mod Forum Management Dashboard</h2>
        </div>
    </div>
    <br />
    <table class="table table-bordered table table-striped" width="100%">
        <thead>
            <tr>
                <th>Forum Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>User Id</th>
                <th>Timestamp</th>
            </tr>
        </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var user = _db.Users.Find(item.User_Id);
                    var firstName = user.FirstName;
                    var lastName = user.LastName;

                    <tr>
                        <td width="15%">@item.Id</td>
                        <td width="15%">@item.Title</td>
                        <td width="20%">@item.Description</td>
                        <td width="15%">@item.User_Id (@firstName @lastName)</td>
                        <td width="5%">@item.Created_At</td>
                        <td width="20%">
                            <div class="w-100 btn-group" role="group">
                                <a asp-controller="Forum" asp-action="DeleteForum" asp-route-Id="@item.Id"
                                class="btn btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
    </table>
    }  else if(User.IsInRole("Instructor") || User.IsInRole("Member")){
        <div class="row pt-4">
            <div class="col-9">
                <h2>Personal Forum Management Dashboard</h2>
            </div>
        </div>
        <br />
        <div class="col-12 text-lg-end">
            <a asp-controller="Forum" asp-action="CreateForum" class="btn btn-success">Let's Talk!</a>
        </div>
        <br />
        <table class="table table-bordered table table-striped" width="100%">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
        <tbody>
                @foreach (var item in filteredForums)
                {
                    <tr>
                        <td width="15%">@item.Title</td>
                        <td width="20%">@item.Description</td>
                        <td width="5%">@item.Created_At</td>
                        <td width="20%">
                            <div class="w-100 btn-group" role="group">
                                <a asp-controller="Forum" asp-action="EditForum" asp-route-Id="@item.Id"
                                    class="btn btn-primary mx-1">Edit</a>
                                <a asp-controller="Forum" asp-action="DeleteForum" asp-route-Id="@item.Id"
                                class="btn btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
        </tbody>
    </table>
   
    }
</div>