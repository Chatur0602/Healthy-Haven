@model ModulesModel

<form method="post" asp-action="DeleteModule">
    <input asp-for="id" hiden />
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-black">Delete Module Details</h2>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="chapter"></label>
                <input asp-for="chapter" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="module"></label>
                <input asp-for="module" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="course_id"></label>
                <input asp-for="course_id" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-danger" value="Delete" />
            <a asp-action="ViewModules" class="btn btn-primary mx-1">Back to Module</a>
        </div>
    </div>
</form>

