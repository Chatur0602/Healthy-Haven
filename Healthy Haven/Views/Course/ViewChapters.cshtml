@model IEnumerable<ChapterModel>

@{
    ViewData["Title"] = "Chapter Management";
}
<head>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
        }

        /* Float four columns side by side */
        .column {
            float: left;
            width: 25%;
            padding: 0 10px;
        }

        /* Remove extra left and right margins, due to padding */
        .row {
            margin: 0 -5px;
        }

            /* Clear floats after the columns */
            .row:after {
                content: "";
                display: table;
                clear: both;
            }

        h2 {
            color: darkgoldenrod;
        }

        /* Style the counter cards */
        .card {
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
            padding: 16px;
            text-align: center;
            background-color: #f1f1f1;
        }

        table {
            font-family: arial, sans-serif;
            border-collapse: collapse;
            width: 100%;
        }

        td, th {
            border: 1px solid #dddddd;
            text-align: left;
            padding: 8px;
        }

            /* Apply the font size specifically for the column with numbers */
            td.numeric-column {
                font-size: 12px;
            }

        .table th, .table td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-height: 3em;
            max-width: 200px; /* Set your desired maximum width */
        }
    </style>
</head>
<body>



    <div>
        <div class="row pt=4">
            <div class="col-9">
                <h2>Chapter Management Dashboard</h2>
            </div>
            <div class="col-12 text-lg-end">
                <a asp-controller="Course" asp-action="CreateChapter" asp-route-moduleId="@Model.First().module_id" class="btn btn-success">Add New Chapter</a>
            </div>
        </div>
        <br />
        @if (Model != null && Model.Count() > 0)
        {
            <table class="table table-bordered table-hover table-striped" width="100%">
                <thead>
                    <tr>
                        <th>Chapter Title</th>
                        <th>Chapter Content</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr >
                            <td width="30%">@item.name</td>
                            <td width="50%">@item.content</td>
                            <td width="20%">
                                <div class="w-100 btn-group" role="group">
                                    <a asp-controller="Course" asp-action="EditChapter" asp-route-id="@item.id" class="btn btn-primary mx-1">Edit</a>
                                    <a asp-controller="Course" asp-action="DeleteChapter" asp-route-id="@item.id" class="btn btn-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <br />
            <p><b>No Records Found</b></p>
        }
    </div>
</body>
