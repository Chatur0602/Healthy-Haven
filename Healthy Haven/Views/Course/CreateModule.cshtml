@model ModulesModel

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-black">Add Module Details</h2>
        </div>
        <br />
       
        <div class="row">
            <div class="col-4">
                <label asp-for="module"></label>
                <input asp-for="module" class="form-control" />
                <span asp-validation-for="module" class="text-danger"></span>
            </div>
        </div>
        <br  />
        <div class="row">
            <div class="col-4">
                <label asp-for="course_id"></label>
                <input asp-for="course_id" class="form-control" />
                <span asp-validation-for="course_id" class="text-danger"></span>
            </div>
        </div>
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-primary" value="Save Details" />
            <a asp-action="ViewModules" class="btn btn-primary mx-1">Back to Module</a>
        </div>
    </div>
</form>

