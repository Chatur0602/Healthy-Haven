@model IEnumerable<ModulesModel>

@{
    ViewData["Title"] = "Module Management";
}
<head>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
        }

        /* Float four columns side by side */
        .column {
            float: left;
            width: 25%;
            padding: 0 10px;
        }

        /* Remove extra left and right margins, due to padding */
        .row {
            margin: 0 -5px;
        }

            /* Clear floats after the columns */
            .row:after {
                content: "";
                display: table;
                clear: both;
            }

        h2 {
            color: darkgoldenrod;
        }

        /* Style the counter cards */
        .card {
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
            padding: 16px;
            text-align: center;
            background-color: #f1f1f1;
        }

        table {
            font-family: arial, sans-serif;
            border-collapse: collapse;
            width: 100%;
        }

        td, th {
            border: 1px solid #dddddd;
            text-align: left;
            padding: 8px;
        }

            /* Apply the font size specifically for the column with numbers */
            td.numeric-column {
                font-size: 12px;
            }

        .table th, .table td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-height: 3em;
            max-width: 200px; /* Set your desired maximum width */
        }

        tbody tr:hover td:not(:last-child) {
            cursor: pointer;
            background-color: #DAA520;
            box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.2);
            transform: scale3d(1.05, 1.05, 1) origin(right, bottom);
            overflow: hidden;
            font-weight: bold;
            color: #000000;
        }

        .tile-icon {
            width: 50px; /* Adjust the width as needed */
            height: 50px; /* Adjust the height as needed */
        }
    </style>
</head>
<body>
                                


    <div>
        <div class="row pt-4">
            <div class="col-9">
                <h2>Module Management Dashboard</h2>
            </div>
        </div>

        <div class="row">
            <div class="col-2">
                <a asp-controller="Course" asp-action="UserCourse">
                    <img src="/icons8-back-100.png" alt="Back" class="tile-icon" />
                </a>
            </div>
            <div class="col-10 text-lg-end">
                <a asp-controller="Course" asp-action="CreateModule" asp-route-courseId="@Model.First().course_id" class="btn btn-success">Add New Module</a>
            </div>
            </div>

        <br />
        @if (Model != null && Model.Count() > 0)
        {

            <br />
            <table class="table table-bordered table-hover table-striped" width="100%">
                <thead>
                    <tr>
                        <th>Module Title</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-module-id="@item.id">
                            <td width="70%">@item.module</td>
                            <td width="30%">
                                <div class="w-100 btn-group" role="group">
                                    <a asp-controller="Course" asp-action="EditModule" asp-route-id="@item.id" class="btn btn-primary mx-1">Edit</a>
                                    <a asp-controller="Course" asp-action="DeleteModule" asp-route-id="@item.id" class="btn btn-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <br />
            <p><b>No Records Found</b></p>
        }
    </div>

    <script>
        document.querySelectorAll('tbody tr').forEach(function (row) {
            row.addEventListener('click', function () {

                var moduleId = row.getAttribute('data-module-id');
                window.location.href = '/Course/ViewChapters?moduleId=' + moduleId;
            });
        });
    </script>
</body>
