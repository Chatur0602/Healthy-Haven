@model CoursesModel

<form method="post" asp-action="DeleteCourse">
    <input asp-for="id" hiden />
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-black">Delete Course Details</h2>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="name"></label>
                <input asp-for="name" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="description"></label>
                <input asp-for="description" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="course_date"></label>
                <input asp-for="course_date" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="credit_hours"></label>
                <input asp-for="credit_hours" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="instructor_id"></label>
                <input asp-for="instructor_id" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="photo"></label>
                <input asp-for="photo" readonly class="form-control" />
            </div>
        </div>
        <br />
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-danger" value="Delete" />
            <a asp-action="Course" class="btn btn-primary mx-1">Back to Course</a>
        </div>
    </div>
</form>

