@model IEnumerable<CoursesModel>
<style>
    .image-carousel {
        width: 100%;
        height: auto;
        margin: 0 auto;
        position: relative;
    }

        .image-carousel img {
            height: 200px;
            width: 100%;
            object-fit: contain;
        }

    .card {
        width: 100%;
        border: 2px solid goldenrod;
        background-color: lightgrey;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .card-title {
        color: darkgoldenrod;
    }

    .slick-prev,
    .slick-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
    }

    .slick-prev {
        left: 10px;
        opacity: 0.5;
    }

    .slick-next {
        right: 10px;
        opacity: 0.5;
    }
</style>
<div>
    <div class="row pt-4">
        <div class="col-9">
            <h2>Healthy Courses</h2>
        </div>
    </div>
    <br />
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@item.name</h5>
                        <div class="image-carousel">
                                <div>
                                    <img src="" alt="Image">
                                </div>
                        </div>
                        <p style="padding-top: 10px;" class="card-text">@item.description</p>
                        <a asp-controller="Course" asp-action="CourseDetails" asp-route-Id="@item.id" class="btn btn-primary mx-1">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>