@using Healthy_Haven.Data;
@inject ApplicationDbContext _db;
@model IEnumerable<CoursesModel>
<style>
    .image-carousel {
        width: 100%;
        height: auto;
        margin: 0 auto;
        position: relative;
    }

        .image-carousel img {
            height: 200px;
            width: 100%;
            object-fit: contain;
        }

    .card {
        width: 100%;
        border: 2px solid goldenrod;
        background-color: lightgrey;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .card-title {
        color: darkgoldenrod;
    }

    .slick-prev,
    .slick-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
    }

    .slick-prev {
        left: 10px;
        opacity: 0.5;
    }

    .slick-next {
        right: 10px;
        opacity: 0.5;
    }
</style>
<div>
    <div class="row pt-4">
        <div class="col-9">
            <h2>Healthy Courses</h2>
        </div>
    </div>
    <br />
    <div class="row">
        @foreach (var item in Model)
        {
            var course = _db.Courses.Find(item.id);

            var courseImages = _db.CourseImages.Where(x => x.course_id == item.id).ToList();
            var imagePaths = courseImages.Select(img => img.image_path).ToList();

            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <div class="image-carousel">
                            @foreach (var path in imagePaths)
                            {
                                @using Amazon.S3;
                                @using Amazon.S3.Model;
                                @using Amazon.S3.Util;

                                var s3Client = new AmazonS3Client("ASIA55H4D3RU3YGBSRC2", "b9NK4j9Q1Yr06QA6pGtwSM3o27h4JqOXoby+mbV+", "", Amazon.RegionEndpoint.USEast1);

                                string bucketName = "healthyhavens3";
                                string folderName = "CourseImages";
                                string imagePath = $"{folderName}/{path}";

                                System.Diagnostics.Debug.WriteLine("IMAGE PATH= " + imagePath);
                                GetPreSignedUrlRequest request = new GetPreSignedUrlRequest
                                {
                                    BucketName = bucketName,
                                    Key = imagePath,
                                    Expires = DateTime.Now.AddMinutes(60)
                                };
                                string preSignedURL = s3Client.GetPreSignedURL(request);
                                <div>
                                    <img src="@preSignedURL" alt="Image">
                                </div>
                            }

                        </div>
                        <h5 class="card-title">@item.name</h5>
                        <p style="padding-top: 10px;" class="card-text">@item.description</p>
                        <a asp-controller="Course" asp-action="CourseDetails" asp-route-Id="@item.id" class="btn btn-primary mx-1">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>