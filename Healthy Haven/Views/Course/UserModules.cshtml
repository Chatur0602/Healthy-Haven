@using Healthy_Haven.Data;
@inject ApplicationDbContext _db;
@model IEnumerable<ModulesModel>

<!DOCTYPE html>
<html>

<head>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.4.1/semantic.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.4.1/semantic.min.js"></script>

    <style>
        /* Updated styles for the page color design */
        body {
            background-color: #F5F5F5; /* Light Gray */
            color: #333; /* Dark Gray */
        }

        .ui.container {
            text-align: center;
            background-color: #FFF; /* White */
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h2.ui.header.green {
            color: #008000; /* Dark Green */
        }

        .ui.dropdown.button {
            background-color: #FFD700; /* Goldenrod */
            color: #333; /* Dark Gray */
            border-radius: 5px; /* Rounded corners */
            font-size: 20px; /* Adjust font size */
            padding: 20px; /* Adjust padding */
            width: 90%; /* Adjust width */
            max-width: 600px; /* Set a maximum width if needed */
        }

            .ui.dropdown.button:hover {
                background-color: #FFC125; /* Darker Goldenrod on hover */
            }

            .ui.dropdown.button .menu {
                max-height: 300px;
                overflow-y: auto;
                background-color: #FFF; /* White */
                border: 1px solid #DDD; /* Light Gray */
                box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
                width: 90%; /* Adjust width to match button width */
                max-width: 600px; /* Set a maximum width if needed */
            }

                .ui.dropdown.button .menu .item {
                    color: #333; /* Dark Gray */
                    margin: 5px 0; /* Adjust margin (vertical margin horizontal margin) */
                }
    </style>
</head>

<body>
    <div class="ui container">
        <br /><br />
        <h2 class="ui header green">Modules</h2>
        <b>
            <p>Here are the available chapters and modules</p>
        </b>
        <hr /><br />

        @if (Model != null && Model.Any())
        {
            <div>
                @foreach (var module in Model)
                {
                    <div class="ui dropdown button">
                        <span class="text"></span>
                        <i class="dropdown icon"></i>
                        <div class="menu">
                            <div class="item">@module.module</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <script>
        $(".ui.dropdown").dropdown();

        function updateDropdownText(dropdown, newText) {
            $(dropdown).find('.text').text(newText);
        }
    </script>
</body>

</html>