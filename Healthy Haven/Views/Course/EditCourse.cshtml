@model CoursesModel

<form method="post" asp-action="Edit">
    <input asp-for="id" hiden />
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-black">Edit Course Details</h2>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="name"></label>
                <input asp-for="name" class="form-control" />
                <span asp-validation-for="name" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="description"></label>
                <input asp-for="description" class="form-control" />
                <span asp-validation-for="description" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="course_date"></label>
                <input asp-for="course_date" class="form-control" />
                <span asp-validation-for="course_date" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="credit_hours"></label>
                <input asp-for="credit_hours" class="form-control" />
                <span asp-validation-for="credit_hours" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="instructor_id"></label>
                <input asp-for="instructor_id" class="form-control" />
                <span asp-validation-for="instructor_id" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-primary" value="Edit Details" />
            <a asp-action="Course" class="btn btn-primary mx-1">Back to Course</a>
        </div>
    </div>
</form>
