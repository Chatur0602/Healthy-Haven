@using Healthy_Haven.Data;
@inject ApplicationDbContext _db;
@model IEnumerable<Healthy_Haven.Models.CoursesModel>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
</head>

<style>
    .image-carousel {
        width: 100%;
        height: auto;
        position: relative;
    }

        .image-carousel img {
            max-width: 100%;
            height: auto;
            object-fit: contain;
            margin: 0 auto; /* Center the image horizontally */
        }

    .card {
        width: 80%; /* Adjust the width as needed */
        margin: 0 auto; /* Center the card horizontally */
        border: 2px solid goldenrod;
        background-color: lightgrey;
        border-radius: 10px;
        margin-bottom: 20px;
        text-align: center; /* Center-align text within the card */
    }

    .card-title {
        color: darkgoldenrod;
        font-size: 1.5rem; /* Adjust font size as needed */
        margin-bottom: 10px;
    }

    .card-text {
        padding-top: 10px;
        margin-bottom: 15px;
    }

    .slick-prev,
    .slick-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
    }

    .slick-prev {
        left: 10px;
        opacity: 0.5;
    }

    .slick-next {
        right: 10px;
        opacity: 0.5;
    }
</style>

<form method="post" asp-action="CourseDetails">
    <div>
        <div class="row pt-4">
            <div class="col-9">
                <h2>Course Details</h2>
            </div>
        </div>
        <br />
        <div class="row">
            @foreach (var item in Model)
            {
                var course = _db.Courses.Find(item.id);

                var courseImages = _db.CourseImages.Where(x => x.course_id == item.id).ToList();
                var imagePaths = courseImages.Select(img => img.image_path).ToList();
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="image-carousel">
                                <div>
                                    @foreach (var path in imagePaths)
                                    {
                                        @using Amazon.S3;
                                        @using Amazon.S3.Model;
                                        @using Amazon.S3.Util;

                                        var s3Client = new Amazon.S3.AmazonS3Client("ASIA2LWVJXALH5MWTXGQ", "RIUT1rBBwoMztcbCyggM5erO4XVbwYE1EUGrcvcN", "", Amazon.RegionEndpoint.USEast1);

                                        string bucketName = "healthyheaven";
                                        string folderName = "CourseImages";
                                        string imagePath = $"{folderName}/{path}";

                                        System.Diagnostics.Debug.WriteLine("IMAGE PATH= " + imagePath);
                                        GetPreSignedUrlRequest request = new GetPreSignedUrlRequest
                                        {
                                            BucketName = bucketName,
                                            Key = imagePath,
                                            Expires = DateTime.Now.AddMinutes(60)
                                        };
                                        string preSignedURL = s3Client.GetPreSignedURL(request);

                                        <div>
                                            <img src="@preSignedURL" alt="Image">
                                        </div>
                                    }
                                </div>
                            </div>
                            <h5 class="card-title">@item.name</h5>
                            <p class="card-text">@item.description</p>
                            <p class="card-text">@item.course_date.ToString("yyyy-MM-dd")</p>
                            <p class="card-text">@item.credit_hours.ToString() hours</p>
                            <a asp-action="UserCourse" class="btn btn-primary mx-1">Back to Course</a>
                            <a asp-action="ViewModules" class="btn btn-primary mx-1">View Modules</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</form>

<script>
    $(document).ready(function () {
        $('.card').each(function () {
            var carousel = $(this).find('.image-carousel');
            var carouselImages = carousel.find('img');

            if (carouselImages.length > 1) {
                carousel.slick({
                    infinite: true,
                    slidesToShow: 1,
                    slidesToScroll: 1,
                    dots: true,
                    autoplay: true,
                    autoplaySpeed: 5000,
                    prevArrow: false,
                    nextArrow: false
                });
            }
        });
    });
</script>

