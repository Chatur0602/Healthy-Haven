@using Healthy_Haven.Data;
@inject ApplicationDbContext _db;
@model IEnumerable<Healthy_Haven.Models.CoursesModel>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
</head>

<style>
    .image-carousel {
        width: 100%;
        height: 300px; /* Set a fixed height for the image carousel */
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .image-carousel img {
        max-width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 10px;
    }

    body {
        font-size: 16px;
        font-size: 1rem;
        font-weight: normal;
        line-height: 1.5;
        color: var(--ic-brand-font-color-dark);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    body {
        min-height: 100vh;
        background: #fff;
        font-weight: 300;
    }

    :root {
        --ic-brand-primary-darkened-5: #F39200;
        --ic-brand-primary-darkened-10: #E68A00;
        --ic-brand-primary-darkened-15: #D98300;
        --ic-brand-primary-lightened-5: #FF9E0C;
        --ic-brand-primary-lightened-10: #FFA319;
        --ic-brand-primary-lightened-15: #FFA826;
        --ic-brand-button--primary-bgd-darkened-5: #F39200;
        --ic-brand-button--primary-bgd-darkened-15: #D98300;
        --ic-brand-button--secondary-bgd-darkened-5: #2B3942;
        --ic-brand-button--secondary-bgd-darkened-15: #27333B;
        --ic-brand-font-color-dark-lightened-15: #444E5A;
        --ic-brand-font-color-dark-lightened-28: #606974;
        --ic-link-color-darkened-10: #0369A3;
        --ic-link-color-lightened-10: #1C81BC;
        --ic-brand-primary: #ff9900;
        --ic-brand-font-color-dark: #232f3e;
        --ic-link-color: #0374B5;
        --ic-brand-button--primary-bgd: var(--ic-brand-primary);
        --ic-brand-button--primary-text: #ffffff;
        --ic-brand-button--secondary-bgd: #2D3B45;
        --ic-brand-button--secondary-text: #ffffff;
        --ic-brand-global-nav-bgd: #232f3e;
        --ic-brand-global-nav-ic-icon-svg-fill: #ffffff;
        --ic-brand-global-nav-ic-icon-svg-fill--active: var(--ic-brand-primary);
        --ic-brand-global-nav-menu-item__text-color: #ffffff;
        --ic-brand-global-nav-menu-item__text-color--active: var(--ic-link-color);
        --ic-brand-global-nav-avatar-border: #ffffff;
        --ic-brand-global-nav-menu-item__badge-bgd: #ffffff;
        --ic-brand-global-nav-menu-item__badge-bgd--active: var(--ic-brand-primary);
        --ic-brand-global-nav-menu-item__badge-text: #000000;
        --ic-brand-global-nav-menu-item__badge-text--active: #ffffff;
        --ic-brand-global-nav-logo-bgd: #394B58;
        --ic-brand-header-image: url(https://instructure-uploads-pdx.s3.us-west-2.amazonaws.com/account_156910000000000001/attachments/326/AWS-Academy_logo_RGB_REV.svg);
        --ic-brand-mobile-global-nav-logo: url(https://instructure-uploads-pdx.s3.us-west-2.amazonaws.com/account_156910000000000001/attachments/5/AWS-Academy_logo_RGB.png);
        --ic-brand-watermark:;
        --ic-brand-watermark-opacity: 1.0;
        --ic-brand-favicon: url(https://du11hjcvx0uqb.cloudfront.net/dist/images/favicon-e10d657a73.ico);
        --ic-brand-apple-touch-icon: url(https://du11hjcvx0uqb.cloudfront.net/dist/images/apple-touch-icon-585e5d997d.png);
        --ic-brand-msapplication-tile-color: var(--ic-brand-primary);
        --ic-brand-msapplication-tile-square: url(https://du11hjcvx0uqb.cloudfront.net/dist/images/windows-tile-eda8889e7b.png);
        --ic-brand-msapplication-tile-wide: url(https://instructure-uploads-pdx.s3.us-west-2.amazonaws.com/account_156910000000000001/attachments/6/AWS-Academy_logo_RGB_ALT-BLK.png);
        --ic-brand-right-sidebar-logo:;
        --ic-brand-Login-body-bgd-color: #232f3e;
        --ic-brand-Login-body-bgd-image:;
        --ic-brand-Login-body-bgd-shadow-color: #2D3B45;
        --ic-brand-Login-logo: url(https://instructure-uploads-pdx.s3.us-west-2.amazonaws.com/account_156910000000000001/attachments/9/AWS-Academy_logo_RGB_REV.png);
        --ic-brand-Login-Content-bgd-color: none;
        --ic-brand-Login-Content-border-color: none;
        --ic-brand-Login-Content-inner-bgd: none;
        --ic-brand-Login-Content-inner-border: none;
        Show All Properties (7 more)
    }

    injected stylesheet
    :host, :root {
        --rem: 16;
    }

    html {
        font-size: 100%;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
        font-family: "Lato Extended","Lato","Helvetica Neue",Helvetica,Arial,sans-serif;
    }
</style>

<body>
<div id="not_right_side" class="ic-app-main-content">
    <div id="content-wrapper" class="ic-Layout-contentWrapper">

        <div id="content" class="ic-Layout-contentMain" role="main">



            
        @foreach (var item in Model)
        {
            var course = _db.Courses.Find(item.id);

            var courseImages = _db.CourseImages.Where(x => x.course_id == item.id).ToList();
            var imagePaths = courseImages.Select(img => img.image_path).ToList();

            <div id="course_home_content">
                <div id="wiki_page_show">
                    <div class="header-bar-outer-container">
                        <div class="sticky-toolbar" data-sticky="">
                            <div class="header-bar page-toolbar as-course-home">
                                <div class="page-toolbar-start">
                                    <div class="page-heading">


                                        <h1 class="course-title" title="AWS Academy Learner Lab [60376]">@item.name</h1>


                                    </div>

                                </div>
                                <div class="page-toolbar-end">

                                    <div class="buttons">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="page-changed-alert" role="alert" aria-atomic="true" aria-live="polite"></div>
                    </div>

                    <div id="direct-share-mount-point"></div>


                        <div class="show-content user_content clearfix enhanced image-carousel">

                            @foreach (var path in imagePaths)
                            {
                                @using Amazon.S3;
                                @using Amazon.S3.Model;
                                @using Amazon.S3.Util;

                                    var s3Client = new Amazon.S3.AmazonS3Client("ASIA2LWVJXALNBRXPOHR", "+BrkhySuKQTq87LXROsJunPHXAGhm9JvsbaTWrAi", "", Amazon.RegionEndpoint.USEast1);

                                string bucketName = "healthyheaven";
                                string folderName = "CourseImages";
                                string imagePath = $"{folderName}/{path}";

                                System.Diagnostics.Debug.WriteLine("IMAGE PATH= " + imagePath);
                                GetPreSignedUrlRequest request = new GetPreSignedUrlRequest
                                {
                                    BucketName = bucketName,
                                    Key = imagePath,
                                    Expires = DateTime.Now.AddMinutes(60)
                                };
                                string preSignedURL = s3Client.GetPreSignedURL(request);

                                <div>
                                    <img src="@preSignedURL" alt="Image">
                                </div>
                            }

                        <p><strong><em> @item.name </em></strong>provides a long-running sandbox environment for ad hoc exploration of AWS services. Within this class, students will have access&nbsp;<em>to&nbsp;<strong>a restricted set of AWS services</strong></em>. Not all AWS documentation walk-through or sample labs that operate in an AWS Production account will work in the Learner Lab environment. You will retain access to the AWS resources set up in this environment for the duration of this course. We limit your budget ($100USD), so you should exercise caution to prevent charges that will deplete your budget too quickly. If you exceed your budget, you will lose access to your environment and lose all of your work.</p>
                        <p>Each duration of the session <strong>@item.credit_hours</strong> hours by default, although you can extend a session to run longer by pressing the start button to reset your session timer. At the end of each session, any resources you created will persist. However, we automatically shut EC2 instances down. Other resources, such as RDS instances, keep running. Keep in mind that we do not stop some AWS features, so they can still incur charges between sessions. For example, an Elastic Load Balancer or a NAT. You may wish to delete those types of resources and recreate them as needed to test your work during a session. You will have access to this environment for the duration of the class that you are enrolled in. When the class ends, your access to the learner lab will also end.</p>
                            <p><span style="color: #232f3e;"><strong><em>For more information</em></strong><br>The course will be held at @item.course_date.ToString("yyyy-MM-dd")<br></span></p>
                        <h3>Get Started</h3>
                        <table style="border-style: none; margin-left: auto; margin-right: auto;">
                            <tbody>
                                <tr style="height: 28px; margin: 0px auto;">
                                    <td style="width: 274px; border-style: hidden; height: 30px;"><a title="Learner Lab Associate Services" href="https://awsacademy.instructure.com/courses/60376/modules/719062" data-api-endpoint="https://awsacademy.instructure.com/api/v1/courses/60376/modules/719062" data-api-returntype="Module"><img style="display: block; margin-left: auto; margin-right: auto;" src="https://awsacademy.instructure.com/courses/60376/files/2812892/preview" alt="Click to start" width="190" height="190" data-api-endpoint="https://awsacademy.instructure.com/api/v1/courses/60376/files/2812892" data-api-returntype="File"></a></td>
                                    <td style="width: 275px; border-style: hidden; height: 30px;">
                                        <p><a title="Introduce Yourself Discussions" href="https://awsacademy.instructure.com/courses/60376/discussion_topics" data-api-endpoint="https://awsacademy.instructure.com/api/v1/courses/60376/discussion_topics" data-api-returntype="[Discussion]"><img style="display: block; margin-left: auto; margin-right: auto;" src="https://awsacademy.instructure.com/courses/60376/files/2812897/preview" alt="Click for discussions" width="179" height="179" data-api-endpoint="https://awsacademy.instructure.com/api/v1/courses/60376/files/2812897" data-api-returntype="File"></a></p>
                                    </td>
                                    <td style="width: 275px;"><a title="Course Support" href="https://awsacademy.instructure.com/courses/60376/pages/course-support" data-api-endpoint="https://awsacademy.instructure.com/api/v1/courses/60376/pages/course-support" data-api-returntype="Page"><img style="display: block; margin-left: auto; margin-right: auto;" src="https://awsacademy.instructure.com/courses/60376/files/2812895/preview" alt="Click to get help" width="172" height="172" data-api-endpoint="https://awsacademy.instructure.com/api/v1/courses/60376/files/2812895" data-api-returntype="File"></a></td>
                                </tr>
                                <tr style="height: 28px;">
                                        <td style="width: 274px; border-style: hidden; height: 29px; text-align: center;">Select <a asp-controller="Module" asp-action="UserModules" asp-route-Id="@item.id">Modules </a>to start the course.</td>
                                    <td style="width: 275px; border-style: hidden; height: 29px;">
                                        <p style="text-align: center;">Use<a href="https://awsacademy.instructure.com/courses/60376/discussion_topics" data-api-endpoint="https://awsacademy.instructure.com/api/v1/courses/60376/discussion_topics" data-api-returntype="[Discussion]"> Discussions</a> to connect with peers.</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
            <div id="wizard_box"></div>
        }
        <script>
            $(document).ready(function () {
                $(".image-carousel").each(function () {
                    var carouselImages = $(this).find('img');

                    if (carouselImages.length > 1) {
                        carouselImages.slick({
                            infinite: true,
                            slidesToShow: 1,
                            slidesToScroll: 1,
                            dots: true,
                            autoplay: true,
                            autoplaySpeed: 5000,
                            prevArrow: false,
                            nextArrow: false
                        });
                    }
                });
            });
        </script>
</div>
</div>
</div>
</body>


