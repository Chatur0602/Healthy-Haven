@model CoursesModel

@{
    ViewData["Title"] = "Create Course";
}

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="border p-5">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2>Add Course Details</h2>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="name"></label>
                <input asp-for="name" class="form-control" />
                <span asp-validation-for="name" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="description"></label>
                <input asp-for="description" class="form-control" />
                <span asp-validation-for="description" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <label asp-for="credit_hours"></label>
                <input asp-for="credit_hours" class="form-control" />
                <span asp-validation-for="credit_hours" class="text-danger"></span>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-4">
                <input type="file" name="files" id="files" multiple />
            </div>
        </div>
        <br  />
        <div class="w-12 btn-group" role="group">
            <input type="submit" class="btn btn-success" value="Save Details" />
            <a asp-action="Course" class="btn btn-primary mx-1">Back to Course</a>
        </div>
    </div>
</form>
